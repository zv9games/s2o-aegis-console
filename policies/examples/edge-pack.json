{
  "schema_version": "0.1.0",
  "name": "example-edge-pack",
  "description": "Enable host firewall, seed DNS blocklist, sync ThreatGrid IOCs, posture gate",
  "firewall": {
    "enabled": true,
    "outbound_block": false
  },
  "dns": {
    "blocklist_path": ".aegis/dns-blocklist.txt",
    "block_domains": [
      "malware.test.s2o",
      "phishing.test.s2o"
    ],
    "unblock_domains": []
  },
  "intel": {
    "sync_blocklist": true,
    "blocklist_path": ".aegis/dns-blocklist.txt",
    "ioc_store_path": ".aegis/ioc-store.json"
  },
  "posture": {
    "min_score": 40
  },
  "gate": {
    "min_score": 50,
    "require_session": true,
    "rate_limit_per_minute": 120,
    "allow_ips": ["127.0.0.1", "::1"],
    "config_path": ".aegis/gate-routes.json"
  }
}
